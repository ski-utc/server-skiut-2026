APP_NAME=Skiut-P26
APP_ENV=local
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_KEY=                                     # Générer avec php artisan key:generate
SIMDE_KEY=RemplacerLaClefIci                 # Remplacer par une clef à donner au SiMDE pendant le déploiement
WEATHER_API_KEY=

#BASE_URL=http://localhost:8000/             #Develop Local
BASE_URL=http://192.168.1.32:8000/           #Develop Serveur
#BASE_URL=https://assos.utc.fr/              #Production
SUBFOLDER=skiutc
APP_URL="${BASE_URL}${SUBFOLDER}"

APP_DEBUG=true                               # Affiche des gros écrans de débug en cas d'erreur 5xx
APP_NO_LOGIN=false                           # Bypass le login du SIMDE pour la connexio à l'API
USER_ID=1                                    # ID du user à prendre en cas de bypass login (mettez celui de votre CAS si vous avez la flemme de seed la BDD)

DB_CONNECTION=sqlite
DB_DATABASE= #Chemin vers ta BDD
DB_FOREIGN_KEYS=true

#DB_CONNECTION=mysql
#DB_HOST=sql.mde.utc
#DB_PORT=3306
#DB_DATABASE=skiutc
#DB_USERNAME=root
#DB_PASSWORD=

OTEL_SERVICE_NAME=skiut-backend
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.namespace.svc.cluster.local:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

OAUTH_URL=https://auth.assos.utc.fr
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/auth/callback"
OAUTH_BACKOFFICE_REDIRECT_URI="${APP_URL}/auth/back-office/callback"
OAUTH_SCOPES="users-infos read-memberships"
OAUTH_AUTHORIZATION_URL="${OAUTH_URL}/oauth/authorize"
OAUTH_ACCESS_TOKEN_URL="${OAUTH_URL}/oauth/token"
OAUTH_RESOURCE_OWNER_DETAILS_URL="${OAUTH_URL}/api/user"
OAUTH_LOGOUT_URL="${OAUTH_URL}/logout"

JWT_PRIVATE_KEY_PATH=app/private/keys/private.pem
JWT_PUBLIC_KEY_PATH=app/private/keys/public.pem

BCRYPT_ROUNDS=12

APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="skiutc@assos.utc.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
